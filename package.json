{
  "name": "buggy-books",
  "version": "1.0.0",
  "private": true,
  "description": "BuggyBooks SQE Practice Target",
  "workspaces": [
    "backend",
    "frontend",
    "playwright-e2e",
    "performance",
    "shared",
    "mobile",
    "mobile-automation"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=buggy-books-backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:mobile": "npm start --workspace=mobile",
    "install:all": "npm install",
    "build": "npm run build --workspace=buggy-books-backend && npm run build --workspace=frontend",
    "typecheck": "concurrently \"npm run build --workspace=buggy-books-backend\" \"npm run build --workspace=frontend\" \"npm run typecheck --workspace=automationframeworks\" \"npm run typecheck:mobile\" \"npm run typecheck:mobile-automation\"",
    "typecheck:mobile": "npx tsc --noEmit -p mobile/tsconfig.json",
    "typecheck:mobile-automation": "npx tsc --noEmit -p mobile-automation/tsconfig.json",
    "test:unit": "concurrently \"npm run test:backend\" \"npm run test:frontend\"",
    "test:backend": "npm test --workspace=buggy-books-backend",
    "test:frontend": "npm test --workspace=frontend",
    "test:mobile:unit": "npm test --workspace=mobile",
    "test:mobile:appium": "npm run test:android --workspace=mobile-automation",
    "test:mobile:appium:android": "npm run test:android --workspace=mobile-automation",
    "test:mobile:appium:ios": "npm run test:ios --workspace=mobile-automation",
    "test:e2e": "npm test --workspace=automationframeworks",
    "test:e2e:local": "npm run test:e2e:local --workspace=automationframeworks",
    "test:e2e:matrix": "npm run test:e2e:all --workspace=automationframeworks",
    "test:api": "npm run test:api --workspace=automationframeworks",
    "test:perf": "npm run test:perf --workspace=buggy-books-performance",
    "test:perf:smoke": "npm run test:perf:smoke --workspace=buggy-books-performance",
    "test:perf:stress": "npm run test:perf:stress --workspace=buggy-books-performance",
    "test:perf:journey": "npm run test:perf:journey --workspace=buggy-books-performance",
    "test:perf:auth": "npm run test:perf:auth --workspace=buggy-books-performance",
    "test:perf:checkout": "npm run test:perf:checkout --workspace=buggy-books-performance",
    "test:perf:soak": "npm run test:perf:soak --workspace=buggy-books-performance",
    "test:perf:breakpoint": "npm run test:perf:breakpoint --workspace=buggy-books-performance",
    "test:lhci": "npx @lhci/cli autorun",
    "lint": "concurrently \"npm run lint:frontend\" \"npm run lint:backend\" \"npm run lint:mobile\" \"npm run lint:e2e\" \"npm run lint:mobile-automation\"",
    "lint:backend": "npm run lint --workspace=buggy-books-backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:mobile": "npm run lint --workspace=mobile",
    "lint:e2e": "npm run lint --workspace=automationframeworks",
    "lint:mobile-automation": "npm run lint --workspace=mobile-automation"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
