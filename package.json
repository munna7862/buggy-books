{
  "name": "buggy-books",
  "version": "1.0.0",
  "description": "BuggyBooks SQE Practice Target",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../playwright-e2e && npm install && cd ..",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "typecheck": "concurrently \"cd backend && npm run build\" \"cd frontend && npx tsc -b\" \"cd playwright-e2e && npx tsc --noEmit\"",
    "test:unit": "concurrently \"npm run test:backend\" \"npm run test:frontend\"",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "cd playwright-e2e && npm test",
    "test:e2e:local": "cd playwright-e2e && npm run test:e2e:local",
    "test:e2e:matrix": "cd playwright-e2e && npm run test:e2e:all",
    "test:perf": "node performance/run-k6.js performance/k6/catalog-load.js",
    "test:perf:stress": "node performance/run-k6.js performance/k6/inventory-stress.js",
    "test:lhci": "npx @lhci/cli autorun",
    "lint": "concurrently \"cd frontend && npm run lint\" \"cd backend && npm run lint\"",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
